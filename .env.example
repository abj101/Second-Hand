# Optional local multimodal proposer. Without this, perception remains OCR/CV-only.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:31b-cloud

# Optional proposal scouts (off the qualified-action hot path). Without a key, --experiment abstains.
PROPOSAL_API_URL=https://api.openai.com/v1
PROPOSAL_API_KEY=
PROPOSAL_MODEL=gpt-5.6
